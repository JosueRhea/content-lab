# cp terraform.tfvars.example terraform.tfvars
# export DIGITALOCEAN_TOKEN=dop_v1_...

region = "nyc3"
name   = "supabase-lab"

# 4GB floor -- same constraint as AWS, different vocabulary.
droplet_size = "s-2vcpu-4gb"

# An SSH key already on your DO account (referenced, not created, so destroy
# will not delete it):
#   ssh-keygen -lf ~/.ssh/id_ed25519.pub -E md5 | awk '{print $2}' | sed 's/^MD5://'
ssh_key_fingerprint = "aa:bb:cc:..."

# Narrow this. Unlike the AWS build, :22 is genuinely open.
# ssh_allowed_cidr = "203.0.113.4/32"

supabase_commit = "HEAD"   # upstream default is master; HEAD avoids guessing
