# cp terraform.tfvars.example terraform.tfvars

region = "us-east-1"
name   = "supabase-lab"

# ~13 containers. t3.micro OOMs; the variable validation will stop you.
instance_type = "t3.medium"

# PIN THIS before going live. Rehearse on the same SHA you present on.
# Find one:  git ls-remote https://github.com/supabase/supabase.git HEAD
supabase_commit = "main"

# Open to the world so the audience can hit it. Narrow for anything real.
# allowed_cidr = "203.0.113.4/32"
